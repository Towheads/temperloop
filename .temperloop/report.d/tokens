#!/usr/bin/env bash
#
# .temperloop/report.d/tokens — the `tokens` drop-in producer's LOCATOR SHIM
# for `temperloop report` (temperloop#958, relocated behind this shim by
# temperloop#980 "producer-kernel-side-relocation").
#
# THIS FILE IS LOCATOR + EXEC ONLY. The real implementation — transcript
# reading, cost weighting, the JSON shaping — lives kernel-side at
# workflows/scripts/report-producers/tokens (see that file's own header for
# the full contract). Do NOT add transcript parsing or jq shaping here: this
# file's whole reason to exist is that a producer copied into an adopter's
# tree is frozen (`temperloop update` never touches
# .temperloop/report.d/tokens) and invisible to check-producer-egress.sh's
# per-repo scan — moving the logic kernel-side fixes both, but only if this
# file stays a thin shim.
#
# CONTRACT (workflows/scripts/lib/report.contract.md § Overlay drop-in
# contract): invoked with no arguments; must exit 0; stdout is either the
# real producer's output (a JSON object carrying `tokens_spent`) or the
# skip line below — never anything else.
#
# RESOLUTION ORDER (read before "simplifying" — temperloop#980 design
# intent):
#   1. $TEMPERLOOP_HOME, if set — the operator-declared install root (a
#      registered setting; see bin/lib/common.sh / bin/bootstrap.sh). This is
#      the PRIMARY resolver: it is explicit and never depends on PATH.
#   2. `command -v temperloop`, symlink-resolved to its real checkout root —
#      the FALLBACK, not the primary. bin/bootstrap.sh's header warns
#      $TEMPERLOOP_BIN_DIR may not be on PATH, and a cron-invoked `report`
#      run can inherit a different PATH than the installing shell, so PATH
#      lookup is the less-reliable of the two signals.
#   3. Neither resolves to a real kernel checkout -> skip.
# This file deliberately does NOT hardcode the install-path literal a FOURTH
# time — bin/bootstrap.sh's own header already names three hand-synced
# copies of it (bootstrap.sh itself, bin/lib/common.sh's
# TEMPERLOOP_CLI_HOME_DEFAULT, bin/README.md). Falling through to
# `command -v temperloop` for the unset-TEMPERLOOP_HOME case gets the same
# real-world coverage (a real install's PATH symlink resolves back to that
# same default root) without a fourth literal to keep in sync by hand.
#
# EGRESS: none — local file checks plus one exec. Scanned by
# check-producer-egress.sh's --overlay-report-d glob.

set -uo pipefail

skip() { echo "skipped -- tokens: producer unavailable"; exit 0; }

producer_rel="workflows/scripts/report-producers/tokens"
kernel_root=""

# 1. $TEMPERLOOP_HOME, if set and non-empty, and it actually carries the
# producer (a stale/partial install shouldn't be trusted over the fallback).
if [ -n "${TEMPERLOOP_HOME:-}" ] && [ -f "$TEMPERLOOP_HOME/$producer_rel" ]; then
  kernel_root="$TEMPERLOOP_HOME"
fi

# 2. `command -v temperloop`, walked through its own symlink chain to the
# real checkout root — same portable loop (no GNU readlink -f) bin/temperloop
# uses to find ITS OWN sibling subcommands/lib dirs.
if [ -z "$kernel_root" ]; then
  cli_path="$(command -v temperloop 2>/dev/null)" || cli_path=""
  if [ -n "$cli_path" ]; then
    _src="$cli_path"
    while [ -L "$_src" ]; do
      _dir="$(cd -P "$(dirname "$_src")" 2>/dev/null && pwd)" || { _src=""; break; }
      _target="$(readlink "$_src")"
      case "$_target" in
        /*) _src="$_target" ;;
        *) _src="$_dir/$_target" ;;
      esac
    done
    if [ -n "$_src" ] && [ -f "$_src" ]; then
      _bin_dir="$(cd -P "$(dirname "$_src")" 2>/dev/null && pwd)" || _bin_dir=""
      # bin/temperloop lives at <checkout-root>/bin/temperloop.
      if [ -n "$_bin_dir" ]; then
        _checkout_root="$(cd -P "$_bin_dir/.." 2>/dev/null && pwd)" || _checkout_root=""
        if [ -n "$_checkout_root" ] && [ -f "$_checkout_root/$producer_rel" ]; then
          kernel_root="$_checkout_root"
        fi
      fi
    fi
  fi
fi

# 3. Neither resolver found a real checkout carrying the producer -> skip.
[ -n "$kernel_root" ] || skip
[ -x "$kernel_root/$producer_rel" ] || skip

exec "$kernel_root/$producer_rel"
