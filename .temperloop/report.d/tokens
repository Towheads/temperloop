#!/usr/bin/env bash
#
# .temperloop/report.d/tokens — the `tokens` drop-in producer's LOCATOR SHIM
# for `temperloop report` (temperloop#958, relocated behind this shim by
# temperloop#980 "producer-kernel-side-relocation").
#
# THIS FILE IS LOCATOR + EXEC ONLY. The real implementation — transcript
# reading, cost weighting, the JSON shaping — lives kernel-side at
# workflows/scripts/report-producers/tokens (see that file's own header for
# the full contract). Do NOT add transcript parsing or jq shaping here: this
# file's whole reason to exist is that a producer copied into an adopter's
# tree is frozen (`temperloop update` never touches
# .temperloop/report.d/tokens) and invisible to check-producer-egress.sh's
# per-repo scan — moving the logic kernel-side fixes both, but only if this
# file stays a thin shim.
#
# CONTRACT (workflows/scripts/lib/report.contract.md § Overlay drop-in
# contract): invoked with no arguments; must exit 0; stdout is either the
# real producer's output (a JSON object carrying `tokens_spent`) or the
# skip line below — never anything else.
#
# RESOLUTION ORDER (read before "simplifying" — temperloop#980 design
# intent; corrected post-review after a regression: the first cut of this
# shim dropped the self-checkout case entirely, silently degrading
# `temperloop report` in THIS repo, and any other checkout carrying its own
# producer, on any host with no installed CLI):
#   1. $TEMPERLOOP_HOME/<producer>, if set and it actually carries the
#      producer — the explicit operator override (a registered setting; see
#      bin/lib/common.sh / bin/bootstrap.sh). Checked first because it is
#      explicit and never depends on PATH or on where this shim itself
#      happens to be sitting.
#   2. $(dirname "$0")/../../<producer> — SELF-CHECKOUT: is this shim
#      already sitting inside a checkout (the kernel repo itself, a linked
#      worktree, a vendored subtree) that carries the producer at that
#      fixed relative path? Fails CLOSED in a real adopter repo (no
#      workflows/ tree there) and falls through — never wrongly claims a
#      checkout that isn't one. Without this step, running this shim from
#      inside a branch that edits workflows/scripts/report-producers/tokens
#      execs the INSTALLED release's copy instead of the code under
#      review, breaking self-hosting; it is also what actually carries a
#      STOCK install day to day, since bin/bootstrap.sh never persists
#      $TEMPERLOOP_HOME (its only shell side effect is printing an `export
#      PATH=…` reminder) — on a stock install step 1 is a no-op and this
#      step is what resolves the kernel before PATH lookup even runs.
#   3. `command -v temperloop`, symlink-resolved to its real checkout root —
#      the PATH-based fallback for a checkout this shim ISN'T sitting
#      inside (a genuine third-party adopter repo). Also load-bearing on a
#      stock install when this shim is invoked from somewhere step 2 can't
#      reach; a cron-invoked `report` run can still inherit a PATH that
#      omits $TEMPERLOOP_BIN_DIR, which is exactly what step 1 (an
#      operator-set $TEMPERLOOP_HOME) exists to route around.
#   4. Nothing resolves to a real kernel checkout -> skip.
# This file deliberately does NOT hardcode the install-path literal a FOURTH
# time — bin/bootstrap.sh's own header already names three hand-synced
# copies of it (bootstrap.sh itself, bin/lib/common.sh's
# TEMPERLOOP_CLI_HOME_DEFAULT, bin/README.md). Steps 2 and 3 get the same
# real-world coverage without a fourth literal to keep in sync by hand.
#
# EGRESS: none — local file checks plus one exec. Scanned by
# check-producer-egress.sh's --overlay-report-d glob.

set -uo pipefail

skip() { echo "skipped -- tokens: producer unavailable"; exit 0; }

producer_rel="workflows/scripts/report-producers/tokens"
kernel_root=""

# 1. $TEMPERLOOP_HOME, if set and non-empty, and it actually carries the
# producer (a stale/partial install shouldn't be trusted over the fallbacks
# below).
if [ -n "${TEMPERLOOP_HOME:-}" ] && [ -f "$TEMPERLOOP_HOME/$producer_rel" ]; then
  kernel_root="$TEMPERLOOP_HOME"
fi

# 2. SELF-CHECKOUT: this shim lives at <checkout-root>/.temperloop/report.d/
# tokens, so <checkout-root> is two levels up from its own location. Checked
# only when it actually resolves to a real file — fails closed in a real
# adopter repo (no workflows/ tree at that relative position) and falls
# through to step 3, exactly like step 1's own existence check above.
if [ -z "$kernel_root" ]; then
  self_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || self_dir=""
  if [ -n "$self_dir" ]; then
    self_root="$(cd "$self_dir/../.." 2>/dev/null && pwd)" || self_root=""
    if [ -n "$self_root" ] && [ -f "$self_root/$producer_rel" ]; then
      kernel_root="$self_root"
    fi
  fi
fi

# 3. `command -v temperloop`, walked through its own symlink chain to the
# real checkout root — same portable loop (no GNU readlink -f) bin/temperloop
# uses to find ITS OWN sibling subcommands/lib dirs.
if [ -z "$kernel_root" ]; then
  cli_path="$(command -v temperloop 2>/dev/null)" || cli_path=""
  if [ -n "$cli_path" ]; then
    _src="$cli_path"
    while [ -L "$_src" ]; do
      _dir="$(cd -P "$(dirname "$_src")" 2>/dev/null && pwd)" || { _src=""; break; }
      _target="$(readlink "$_src")"
      case "$_target" in
        /*) _src="$_target" ;;
        *) _src="$_dir/$_target" ;;
      esac
    done
    if [ -n "$_src" ] && [ -f "$_src" ]; then
      _bin_dir="$(cd -P "$(dirname "$_src")" 2>/dev/null && pwd)" || _bin_dir=""
      # bin/temperloop lives at <checkout-root>/bin/temperloop.
      if [ -n "$_bin_dir" ]; then
        _checkout_root="$(cd -P "$_bin_dir/.." 2>/dev/null && pwd)" || _checkout_root=""
        if [ -n "$_checkout_root" ] && [ -f "$_checkout_root/$producer_rel" ]; then
          kernel_root="$_checkout_root"
        fi
      fi
    fi
  fi
fi

# 4. Nothing resolved a real checkout carrying the producer -> skip.
[ -n "$kernel_root" ] || skip
[ -x "$kernel_root/$producer_rel" ] || skip

# execfail: a bad interpreter or a noexec install root can make `exec` ITSELF
# fail even though the executable bit is set (realistic trigger: `report`
# racing `temperloop update` mid-checkout). Without this shell option, a
# failed exec normally terminates the shell outright — never reaching the
# `|| skip` below — leaking exec's own stderr and exiting 126, both things
# this file's own CONTRACT paragraph above promises never happen.
shopt -s execfail
# Args passthrough ("$@"): the drop-in contract is "invoked with no
# arguments" today, so this is zero-cost now, but it closes off having to
# re-edit this exact file — the one that gets frozen, unedited, in every
# adopter repo that runs `temperloop init` — if that contract ever grows a
# flag.
exec "$kernel_root/$producer_rel" "$@" || skip
