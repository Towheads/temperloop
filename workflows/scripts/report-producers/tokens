#!/usr/bin/env bash
#
# workflows/scripts/report-producers/tokens — kernel-side implementation of
# the `tokens` `.temperloop/report.d/` drop-in producer (originally
# temperloop#958; relocated here by temperloop#980
# "producer-kernel-side-relocation").
#
# WHY THIS LIVES HERE, NOT UNDER .temperloop/report.d/: a producer placed
# directly in an adopter repo's `.temperloop/report.d/` is a byte-for-byte
# COPY that `temperloop update` never touches (frozen at whatever version
# `init` placed) and sits outside `check-producer-egress.sh`'s per-repo scan.
# Living here instead means this file updates with the kernel checkout, and
# the file actually committed to an adopter's `.temperloop/report.d/tokens`
# (see that path in THIS repo for the kernel's own copy) is a thin locator +
# `exec` shim with no transcript parsing and no jq shaping of its own — see
# that file's header for the resolution order it uses to find this one.
#
# CONTRACT (workflows/scripts/lib/report.contract.md § Overlay drop-in
# contract): invoked with no arguments. Must exit 0 and print a
# self-contained block of stdout that ALSO parses as a single JSON object
# carrying a numeric `tokens_spent` field for report.sh to render the
# "tokens spent vs items merged" headline; an optional `by_model` object
# feeds the directional dollar line when the repo also carries a
# hand-written `.temperloop/pricing.json`.
#
# DEGRADATION: every failure path prints the contract's own one-line
# `skipped -- tokens: producer unavailable` and exits 0 — never a non-zero
# exit, never a stack trace, never a partially-written JSON object. report.sh
# then renders that line verbatim and falls back to the kernel-tier headline,
# exactly as it would for an absent producer.
#
# EGRESS: none. Everything below is a local file read (the sibling profiler
# walks $SPEND_TRANSCRIPT_ROOT) plus `jq`. No curl, no gh, no API — this file
# is scanned by `make test-producer-egress`
# (workflows/scripts/kernel/check-producer-egress.sh, whose header documents
# this loop's egress surface as EMPTY, and whose named-file list covers this
# exact path since temperloop#980).
#
# SETTINGS RESOLUTION BOUNDARY (temperloop#980): this file execs the sibling
# ../pipeline-spend-report.sh, which resolves build.config.sh from its OWN
# `$SCRIPT_DIR/../..` — always the KERNEL checkout now, never the invoking
# repo's own copy (pre-#980, when this logic lived at
# .temperloop/report.d/tokens inside the invoking repo, that same climb
# landed on the invoking repo's build.config.sh instead). So
# SPEND_TRANSCRIPT_ROOT, the SPEND_WEIGHT_* cost weights, and
# BASELINE_SNAPSHOT_LOOKBACK_DAYS (read a few lines below) now come
# unconditionally from the kernel's own layer-5 tracked-repo config; an
# adopter repo can still override any of them, but only at layer 2 (an
# exported env var) per docs/config-precedence.md's ladder — layer 5 no
# longer reads the adopter's own file.
#
# WHAT tokens_spent MEANS: DIRECTIONAL cost-weighted units, not dollars and
# not raw tokens — see ../pipeline-spend-report.sh's header for the
# weighting and the four correctness traps it encodes, and
# ../lib/report.contract.md § Non-goals for why this loop never claims
# precision. `by_model` is reported in the SAME cost-weighted units as
# `tokens_spent`, so the two are internally consistent (the parts sum to the
# whole).
#
# CORPUS SCOPE (temperloop#983): the profiler's --root defaults to
# $SPEND_TRANSCRIPT_ROOT, i.e. the WHOLE of $HOME/.claude/projects — every
# repo this operator has ever run Claude Code against on this machine, not
# just the one that is invoking `temperloop report`. Left unset, that made
# `tokens_spent / merged_count` divide EVERY project's spend on this
# machine by only THIS repo's merged-item count — invisible in the kernel's
# own dogfooding (one repo dominates the corpus here) but wrong for any
# other adopter.
#
# THE FIX: scope --root to THIS checkout's own Claude Code project
# directory, computed FORWARD from a known real path — never decoded
# backward. Claude Code names a project's transcript directory by taking the
# checkout's absolute path and replacing every non-alphanumeric character
# ('/' and '.' alike) with '-' (verified against this machine's real
# ~/.claude/projects/ listing during #983's investigation: e.g.
# /Users/x/dev/batch/foundation.wt/some-slug encodes to
# -Users-x-dev-batch-foundation-wt-some-slug). That transform is lossy in
# the REVERSE direction — "...repo.wt.slug..." and "...repo--claude-
# worktrees.slug..." are indistinguishable once collapsed to dashes — so
# this script never tries to pattern-match or enumerate existing
# ~/.claude/projects/ entries. It only ever encodes ONE path it already
# knows for certain: `git rev-parse --show-toplevel` of its own cwd, which
# report.contract.md's Overlay drop-in contract fixes as "the target repo".
#
# WHY THIS IS ENOUGH, NOT JUST "CLOSE ENOUGH": Claude Code writes a
# subagent's transcript under the ORCHESTRATING session's own project
# directory (keyed by that session's cwd at spawn time) — never under
# whatever directory the subagent itself later `cd`s into. A `/build` item
# worker launched from this checkout, that does its actual work inside an
# isolated LINKED worktree elsewhere on disk, still leaves its transcript
# under this checkout's own project directory. #983 confirmed this
# empirically on this machine: the checkout's own project dir carried
# hundreds of workflow agent transcripts while six sibling per-worktree
# project dirs for the same repo carried zero. A genuinely DIFFERENT
# checkout or clone of the same repo (a separate `git clone`, not a linked
# worktree of this one) gets its own, unrelated project directory and is
# correctly EXCLUDED — that is a different corpus, not this checkout's
# spend, and this machine carries three such independent temperloop clones
# with wildly different transcript counts (evidence a single "repo" is not
# a single directory).
#
# DEGRADE, NOT GUESS: if this cwd is not inside a git working tree (`git
# rev-parse` fails), or the derived path does not exist, or the CALLER
# already overrode $SPEND_TRANSCRIPT_ROOT to something OTHER than its own
# default — this script does not pass --root at all and lets the profiler
# fall back to its default, machine-wide by construction. Whichever corpus
# is actually walked, the `notice` field below (workflows/scripts/lib/
# report.contract.md's notice channel, temperloop#981) states that TRUE
# scope, never a hardcoded claim — see the scope_notice assignment below,
# which is set from the SAME branch that decides whether --root is passed.
# THREE distinct notices, not two (temperloop#983 review): repo-scoped
# success; repo-scoping unavailable (not a git tree, or an explicit
# non-default override) → generic machine-wide; and repo-scoping SUCCEEDED
# at deriving a path but that path doesn't exist yet (a genuinely fresh or
# empty checkout) → a THIRD notice naming the exact path, because silently
# falling back to machine-wide there would look identical to a real,
# populated repo-scoped zero — an undetectable wrong number is worse than
# the bug this item exists to fix. See the `scoped_root_missing` branch
# below.
#
# "OVERRIDE" DETECTION (temperloop#983 review, finding 3): naively treating
# any non-empty $SPEND_TRANSCRIPT_ROOT as an explicit override defeats this
# whole fix in the most common real invocation path — every command spec
# that follows the kernel's § Named-setting convention sources
# build.config.sh at its own Step 0, which does `:
# "${SPEND_TRANSCRIPT_ROOT:=$HOME/.claude/projects}"` and EXPORTS it (see
# that file's own `export SPEND_TRANSCRIPT_ROOT ...` line), so by the time
# this producer runs as a child of such a session, $SPEND_TRANSCRIPT_ROOT is
# ALREADY non-empty with the machine-wide DEFAULT, not a caller's deliberate
# choice. So: only a value that DIFFERS from that documented default counts
# as an override (test fixtures naturally clear this bar — they point at a
# throwaway tmpdir). This is a heuristic, not a perfect signal — an operator
# who explicitly re-asserts the literal default value is indistinguishable
# from one who never touched it, and this script does not try to
# distinguish them; there is no separate opt-out flag today.
#
# CWD-KEYING CAVEAT (temperloop#983 review, finding 6): Claude Code keys a
# project's transcript directory on the SESSION'S OWN LAUNCH cwd, which this
# script approximates with `git rev-parse --show-toplevel` (the git
# TOPLEVEL of our cwd), not the literal cwd itself. Those two can diverge —
# a session launched from a SUBDIRECTORY of a checkout gets its own,
# different project directory that this encoding will never find (this
# machine carries a real example: `foundation-cron/workflows`, 34
# transcripts, invisible to a toplevel-keyed encode of `foundation-cron`).
# This is a known, accepted UNDER-count, not a bug to chase: pattern-
# matching or globbing for such subdirectory variants would reintroduce the
# exact reverse-decode ambiguity this script deliberately refuses (see
# "THE FIX" above) — it is latent today only because no such divergent
# directory happens to carry workflow transcripts, not because the risk
# doesn't exist structurally.
#
# LOCALE (temperloop#983 review, finding 4): the encode step below pins
# `LC_ALL=C` on its one `sed` call so the character class matches per-BYTE
# regardless of the ambient locale (a UTF-8 locale would match per-character
# instead, and cron/launchd/CI commonly already run under `LC_ALL=C` — an
# inconsistent locale between the encoder and Claude Code's own JS-side
# per-UTF-16-code-unit encoding would silently produce the WRONG directory
# name for an astral-plane character in a checkout path). Practically: a
# checkout path containing only ASCII is unaffected either way; a non-ASCII
# checkout path is UNSUPPORTED (falls through to the "doesn't exist" branch
# below, degrading legibly rather than silently miscounting).

set -uo pipefail

skip() { echo "skipped -- tokens: producer unavailable"; exit 0; }

# Sibling-relative resolution: this file lives at
# workflows/scripts/report-producers/tokens, one level below
# workflows/scripts/pipeline-spend-report.sh — a fixed, kernel-internal
# relationship (unlike the pre-#980 shape, this no longer depends on where
# the INVOKING repo happens to keep its own checkout).
self_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || skip
profiler="$self_dir/../pipeline-spend-report.sh"

[ -f "$profiler" ] || skip
command -v jq >/dev/null 2>&1 || skip

# Match the baseline's own lookback window, so "tokens spent vs items merged"
# divides two numbers drawn from the SAME period. BASELINE_SNAPSHOT_LOOKBACK_DAYS
# is bin/subcommands/baseline-snapshot.sh's registered setting; the literal
# here is its documented byte-identical non-vendoring fallback, the same
# convention PIPELINE_OPERATOR's duplicate seams use.
lookback="${BASELINE_SNAPSHOT_LOOKBACK_DAYS:-90}"
case "$lookback" in ''|*[!0-9]*) lookback=90 ;; esac

# Portable "N days before today" — GNU coreutils on Linux CI, BSD date on
# macOS. Same two-branch shape as baseline-snapshot.sh's own
# _baseline_date_sub_days; never a bare `date -d`, which is GNU-only and
# silently fails on macOS.
today="$(date -u +%Y-%m-%d 2>/dev/null)" || today=""
since=""
if [ -n "$today" ]; then
  if date --version >/dev/null 2>&1; then
    since="$(date -u -d "$today -${lookback} days" +%Y-%m-%d 2>/dev/null || true)"
  else
    since="$(date -u -j -v-"${lookback}"d -f "%Y-%m-%d" "$today" +%Y-%m-%d 2>/dev/null || true)"
  fi
fi

# --- repo scoping (temperloop#983) -----------------------------------------
# See the header comment above for the full rationale, including the three-
# notice shape and the override-detection heuristic. Compute this repo's own
# Claude Code project directory by FORWARD-encoding a path we already know
# for certain (git's own toplevel of our cwd) — never by pattern-matching or
# decoding existing ~/.claude/projects/ entries, which is lossy.
#
# override detection: only a $SPEND_TRANSCRIPT_ROOT that DIFFERS from its
# own documented default counts as a caller override (see header finding 3)
# — the mere presence of the var, exported at its default by any session
# that sourced build.config.sh, must not defeat repo-scoping.
transcript_root_overridden=0
default_transcript_root="${HOME:-}/.claude/projects"
if [ -n "${SPEND_TRANSCRIPT_ROOT:-}" ] && [ "$SPEND_TRANSCRIPT_ROOT" != "$default_transcript_root" ]; then
  transcript_root_overridden=1
fi

scoped_root=""
scoped_root_missing=""
if [ "$transcript_root_overridden" -eq 0 ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || repo_root=""
  if [ -n "$repo_root" ] && [ -n "${HOME:-}" ]; then
    # LC_ALL=C pinned on this one call (header finding 4): per-BYTE matching,
    # independent of the ambient locale.
    encoded="$(printf '%s' "$repo_root" | LC_ALL=C sed 's/[^A-Za-z0-9]/-/g')"
    # Guard `encoded` non-empty (header finding 5): an empty encode would
    # make the candidate literally "$HOME/.claude/projects/" -- which
    # EXISTS, so the missing-dir check below would never catch it, and this
    # script would silently walk the whole machine while claiming
    # repo-scoping. Not reachable today (sed on a non-empty input always
    # emits SOME output), but the failure mode of a silent gap here is
    # exactly the lying notice this whole review round exists to kill.
    if [ -n "$encoded" ]; then
      candidate_root="$HOME/.claude/projects/$encoded"
      # Existence check (header finding 1, BLOCKING): a derived root that
      # does not exist must NOT be passed to --root silently. The profiler
      # (pipeline-spend-report.sh) treats a nonexistent --root as a
      # legitimate empty corpus -- valid JSON, units_total: 0, exit 0 -- so
      # without this check a fresh clone, a linked worktree, a CI runner, or
      # any $HOME that differs from the session that recorded the
      # transcripts would silently render "0 tokens" under a "THIS git
      # checkout" notice: a wrong number that asserts its own correctness,
      # strictly worse than the machine-wide number it replaced.
      if [ -d "$candidate_root" ]; then
        scoped_root="$candidate_root"
      else
        scoped_root_missing="$candidate_root"
      fi
    fi
  fi
fi

if [ -n "$scoped_root" ]; then
  scope_notice="directional cost-weighted token spend, scoped to THIS git checkout on this machine only -- not comparable across teammates, machines, or other clones/checkouts of this repo."
  if [ -n "$since" ]; then
    raw="$(bash "$profiler" --format json --since "$since" --root "$scoped_root" 2>/dev/null)" || skip
  else
    raw="$(bash "$profiler" --format json --root "$scoped_root" 2>/dev/null)" || skip
  fi
elif [ -n "$scoped_root_missing" ]; then
  # The THIRD notice (header finding 1): repo-scoping succeeded at deriving
  # a path, but nothing has ever been recorded there -- a genuinely empty or
  # fresh checkout is real, so this is not an error, but it must be named
  # explicitly rather than silently substituting the machine-wide corpus
  # under a claim of repo-scoping. The exact path is included so the
  # operator can diff it against their own `ls ~/.claude/projects`.
  scope_notice="no Claude Code transcripts recorded for this checkout ($scoped_root_missing); reporting machine-wide instead -- not comparable across teammates or machines."
  if [ -n "$since" ]; then
    raw="$(bash "$profiler" --format json --since "$since" 2>/dev/null)" || skip
  else
    raw="$(bash "$profiler" --format json 2>/dev/null)" || skip
  fi
else
  # Machine-wide fallback -- repo-scoping was never attempted at all (not a
  # git working tree, or the caller genuinely overrode
  # $SPEND_TRANSCRIPT_ROOT to something other than its own default; either
  # way we don't second-guess an explicit override, but we also can't claim
  # it's scoped to this repo).
  scope_notice="directional cost-weighted token spend across every Claude Code project on this machine -- not comparable across teammates or machines."
  # An unresolvable window is not a failure — report the whole corpus rather
  # than nothing, and let the report's own DIRECTIONAL label carry the caveat.
  if [ -n "$since" ]; then
    raw="$(bash "$profiler" --format json --since "$since" 2>/dev/null)" || skip
  else
    raw="$(bash "$profiler" --format json 2>/dev/null)" || skip
  fi
fi
[ -n "$raw" ] || skip

# Zero-unit models are dropped from by_model: they add nothing to a priced
# total and would only surface in report.sh's "excluded, no matching price"
# list as noise (Claude Code records a `<synthetic>` pseudo-model for
# locally-generated messages that cost nothing).
#
# `notice` (workflows/scripts/lib/report.contract.md's notice channel,
# temperloop#981) always carries the comparability caveat, and its wording
# is set from the SAME branch above that decided whether --root was passed
# -- so the text always describes the corpus this run actually walked, not
# a hardcoded claim.
out="$(printf '%s' "$raw" | jq -c --arg notice "$scope_notice" '
  select((.units_total | type) == "number")
  | (if (.by_model | type) == "object"
     then (.by_model | with_entries(select((.value | type) == "number" and .value > 0)))
     else {} end) as $bm
  | {tokens_spent: .units_total, notice: $notice}
    + (if ($bm | length) > 0 then {by_model: $bm} else {} end)
' 2>/dev/null)" || skip

[ -n "$out" ] || skip
printf '%s\n' "$out"
