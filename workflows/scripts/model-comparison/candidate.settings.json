{
  "permissions": {
    "deny": [
      "mcp__obsidian__*",
      "mcp__obsidian-builtin__*",
      "mcp__things__*",
      "Read(*build.config.local.sh*)",
      "Edit(*build.config.local.sh*)",
      "Write(*build.config.local.sh*)",
      "Grep(*build.config.local.sh*)",
      "Read(*build.config.machine.sh*)",
      "Edit(*build.config.machine.sh*)",
      "Write(*build.config.machine.sh*)",
      "Grep(*build.config.machine.sh*)",
      "Read(*.env)",
      "Read(*.env.*)",
      "Edit(*.env)",
      "Edit(*.env.*)",
      "Write(*.env)",
      "Write(*.env.*)",
      "Grep(*.env)",
      "Grep(*.env.*)",
      "Bash(*build.config.local.sh*)",
      "Bash(*build.config.machine.sh*)",
      "Bash(*.env*)"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "Task"
    ]
  }
}
